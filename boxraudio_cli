#!/usr/bin/env python3
"""
boxraudio — BoxR CLI entry point.

Version is sourced from boxraudio.__version__ (single source of truth).
This file is intentionally minimal: it parses arguments and dispatches
to a handler function in boxraudio.commands.
"""

import sys
import os
import argparse

if "/usr/local/lib" not in sys.path:
    sys.path.insert(0, "/usr/local/lib")

_script_dir = os.path.dirname(os.path.realpath(__file__))
if _script_dir not in sys.path:
    sys.path.insert(0, _script_dir)


def build_parser():
    parser = argparse.ArgumentParser(
        prog="boxraudio",
        description="BoxR — versatile media library sync, dedup, and cleanup tool.",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="Run with --examples for usage examples.",
    )

    # Profile / config
    parser.add_argument("-p", "--profile", action="append", metavar="NAME",
                        help="Load settings from a profile (repeatable for sequential runs)")
    parser.add_argument("--list-profiles", action="store_true",
                        help="List available profiles from config and exit")
    parser.add_argument("--explain", action="store_true",
                        help="Show what the selected profile(s) would do without running")
    parser.add_argument("--config", metavar="PATH",
                        help="Path to alternate config file")

    # Paths
    parser.add_argument("-s", "--source",          metavar="PATH",
                        help="Source directory (new files to process)")
    parser.add_argument("-b", "--backup",          metavar="PATH",
                        help="Backup directory (files moved here from source)")
    parser.add_argument("-d", "--destination",     metavar="PATH", action="append",
                        help="Destination directory (repeatable)")
    parser.add_argument("--sync-source",     metavar="PATH",
                        help="Override sync source root")
    parser.add_argument("--sync-destination", metavar="PATH", action="append",
                        help="Override sync destination root (repeatable)")

    # Dedup
    parser.add_argument("--dedupe-format", metavar="EXT",
                        help="File extension to deduplicate (e.g. mp3)")
    parser.add_argument("--dedupe-search", metavar="PATH", action="append",
                        help="Directory to search for duplicates (repeatable)")
    parser.add_argument("--dedupe-method", choices=["tag", "fingerprint"], default=None,
                        help="Dedup matching method (default: tag)")
    parser.add_argument("--clean-empty-dirs", action="store_true",
                        help="Remove empty/audio-free directories after dedup")

    # Sync
    parser.add_argument("--mirror",      action="store_true",
                        help="rsync with --delete (mirror destination to backup)")
    parser.add_argument("--size-only",   action="store_true",
                        help="rsync compares files by size only")
    parser.add_argument("--rsync-flags", metavar="FLAGS",
                        help="Extra rsync flags")

    # Performance
    parser.add_argument("--workers", type=int, metavar="N",
                        help="Parallel tag-reading workers")

    # Cache
    parser.add_argument("--cache-file",    metavar="PATH",
                        help="Cache file location")
    parser.add_argument("--rebuild-cache", action="store_true",
                        help="Discard existing cache and rebuild")
    parser.add_argument("--cache-info", action="store_true",
                        help="Show cache statistics and exit")

    # Safety
    parser.add_argument("-r", "--run",        action="store_true",
                        help="Execute changes (default is dry run)")
    parser.add_argument("--no-confirm", action="store_true",
                        help="Skip YES confirmations")

    # Sessions
    parser.add_argument("--undo", action="store_true",
                        help="Undo the most recent completed session")
    parser.add_argument("--history", action="store_true",
                        help="Show recent sessions")
    parser.add_argument("--detailed", action="store_true",
                        help="Show detailed information with --history")
    parser.add_argument("--stats", action="store_true",
                        help="Show aggregate library statistics")

    # Resume
    parser.add_argument("--resume", action="store_true",
                        help="Resume the most recently interrupted session")
    parser.add_argument("--list-resumable", action="store_true",
                        help="List interrupted sessions available for resume")

    # Audits
    parser.add_argument("-Q", "--audit-quality", action="store_true",
                        help="Run spectrum analysis to detect lossy transcodes")
    parser.add_argument("--audit-tags", action="store_true",
                        help="Audit tag quality (missing/suspicious metadata)")
    parser.add_argument("-R", "--report-quality", action="store_true",
                        help="Generate a library quality report")
    parser.add_argument("-t", "--target", metavar="PATH",
                        help="Target directory for audit/report/sanitize commands")
    parser.add_argument("--no-reasons", action="store_true",
                        help="Suppress inline reasoning in spectrum audit output")

    # Sanitization
    parser.add_argument("-S", "--sanitize-tags", action="store_true",
                        help="Strip superfluous metadata from files (standalone command)")
    parser.add_argument("--sanitize-on-move", action="store_true",
                        help="Auto-sanitize files as they move from source to backup")
    parser.add_argument("--strip-art", action="store_true",
                        help="Also strip embedded album art when sanitizing")
    parser.add_argument("--strip-lyrics", action="store_true",
                        help="Also strip lyrics when sanitizing")
    parser.add_argument("--keep-tag", action="append", metavar="TAG",
                        help="Additional tag(s) to preserve during sanitization (repeatable)")
    parser.add_argument("--art-threshold-mb", type=float, default=1.0,
                        help="Flag embedded art larger than this many MB (default: 1.0)")

    # Output
    parser.add_argument("--report",    metavar="FILE",
                        help="Save full report to this file")
    parser.add_argument("--no-banner", action="store_true",
                        help="Suppress the ASCII banner")
    parser.add_argument("--examples",  action="store_true",
                        help="Show example usage and exit")
    parser.add_argument("-i", "--interactive", action="store_true",
                        help="Guided interactive mode")
    parser.add_argument("-V", "--version",   action="store_true",
                        help="Show version and exit")

    return parser


def dispatch(args, config):
    """Dispatch to the appropriate command handler based on flags."""
    from boxraudio import commands

    # Order matters: information-only commands first, then actions, then pipeline
    if args.version:           return commands.cmd_version(args, config)
    if args.examples:          return commands.cmd_examples(args, config)
    if args.list_profiles:     return commands.cmd_list_profiles(args, config)
    if args.cache_info:        return commands.cmd_cache_info(args, config)
    if args.explain:           return commands.cmd_explain(args, config)

    if args.undo:              return commands.cmd_undo(args, config)
    if args.stats:             return commands.cmd_stats(args, config)
    if args.history:           return commands.cmd_history(args, config)
    if args.list_resumable:    return commands.cmd_list_resumable(args, config)
    if args.resume:            return commands.cmd_resume(args, config)

    if args.audit_quality or args.audit_tags or args.report_quality:
        return commands.cmd_audits(args, config)

    if args.sanitize_tags:     return commands.cmd_sanitize_tags(args, config)

    if args.interactive:       return commands.cmd_interactive(args, config)

    # Default: run the pipeline
    return commands.cmd_pipeline(args, config)


def main():
    from boxraudio import ui
    from boxraudio.banner import print_banner
    from boxraudio.config import load_config, ConfigError

    parser = build_parser()
    args = parser.parse_args()

    # Auto-disable banner on non-TTY (cron jobs, pipes, scripts)
    if not args.no_banner and sys.stdout.isatty() and not args.version:
        print_banner()

    try:
        config = load_config(args.config)
    except ConfigError as e:
        ui.error(str(e))
        sys.exit(1)

    try:
        exit_code = dispatch(args, config)
    except KeyboardInterrupt:
        ui.warning("\nInterrupted by user.")
        exit_code = 130
    except Exception as e:
        ui.error(f"Unexpected error: {e}")
        if os.environ.get("BOXRAUDIO_DEBUG"):
            import traceback
            traceback.print_exc()
        exit_code = 1

    sys.exit(exit_code or 0)


if __name__ == "__main__":
    main()
